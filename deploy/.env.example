# NetraVision v3.0 — contoh environment untuk deploy/docker-compose.yml
# Disalin menjadi deploy/.env oleh deploy/install.sh (tidak di-commit bila berisi secret).
# JANGAN commit file .env yang sudah terisi ke repo.

# --- PostgreSQL ---
POSTGRES_DB=netravision
POSTGRES_USER=netravision
# Dibuat otomatis oleh install.sh bila masih placeholder. Format: hex 32 char.
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_INSTALL_SH

# --- API (FastAPI) ---
# Port host (localhost saja) tempat API di-publish; Apache mem-proxy ke sini.
API_PORT=8100
# Dibuat otomatis oleh install.sh bila masih placeholder. Format: hex 64 char.
JWT_SECRET=CHANGE_ME_GENERATED_BY_INSTALL_SH
# Umur token (menit): access pendek + refresh rotation (pelajaran dari audit T10).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Frontend ---
# URL publik (dipakai saat build static export bila perlu).
PUBLIC_BASE_URL=https://netra.mamura.net.id

# --- Rekaman: poster & retensi ---
POSTERS_ENABLED=true
POSTER_INTERVAL_SEC=60
RETENTION_ENABLED=true

# --- Google Drive (modul opsional, multi-akun) ---
DRIVE_ENABLED=false
DRIVE_FOLDER_ROOT=NetraVision
DRIVE_RETENTION_DAYS=30
# Kunci Fernet untuk enkripsi token OAuth akun Drive di DB (wajib bila DRIVE_ENABLED=true).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JANGAN commit nilai aslinya. Lihat docs/GOOGLE-DRIVE.md §5 (generate & rotasi).
DRIVE_TOKEN_KEY=
# credentials.json (OAuth Web app) ditaruh manual di data/drive/ (lihat docs/GOOGLE-DRIVE.md §1).
# PUBLIC_BASE_URL wajib diset agar redirect_uri OAuth valid.
