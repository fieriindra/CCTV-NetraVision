# NetraVision v3.0 — contoh konfigurasi environment.
# Salin ke .env lalu isi. JANGAN commit .env berisi rahasia asli.

APP_ENV=dev
APP_VERSION=3.0.0a0

# PostgreSQL (server diinstal via apt/systemd atau container; BUKAN di venv)
DATABASE_URL=postgresql+asyncpg://netravision:netravision@127.0.0.1:5432/netravision

# JWT — WAJIB diganti di produksi (string acak >= 32 karakter)
JWT_SECRET=CHANGE-ME-IN-PROD
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Login tamu ala v2.0 (nonaktif secara default)
GUEST_ENABLED=false
GUEST_PASSWORD=

# MediaMTX
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WHEP_BASE=http://127.0.0.1:8889

# Poster (butuh ffmpeg di server; mati otomatis bila tak ada)
POSTERS_ENABLED=true
POSTER_INTERVAL_SEC=60

# Retensi lokal harian (per kamera: retention_days di DB)
RETENTION_ENABLED=true

# Google Drive — MODUL OPSIONAL, default nonaktif
DRIVE_ENABLED=false
DRIVE_CREDENTIALS_FILE=data/drive/credentials.json
DRIVE_TOKEN_FILE=data/drive/token.json
DRIVE_FOLDER_ROOT=NetraVision
DRIVE_RETENTION_DAYS=30

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO
